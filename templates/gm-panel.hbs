<section class="fate-dice-panel">
  <div class="fate-dice-panel-toolbar">
    <button type="button" class="fate-dice-session-start" data-action="sessionStart">
      <i class="fa-solid fa-sun"></i> {{localize "FATEDICE.Panel.SessionStart"}}
    </button>
    <button type="button" data-action="editShop"><i class="fa-solid fa-store"></i> {{localize "FATEDICE.Panel.EditShop"}}</button>
  </div>
  <p class="fate-dice-panel-session">{{localize "FATEDICE.Panel.Session" number=session}}</p>
  {{#if rows.length}}
    <ul class="fate-dice-party">
      {{#each rows}}
        <li class="fate-dice-member" data-actor-id="{{id}}">
          <img src="{{img}}" alt="" width="36" height="36">
          <div class="fate-dice-member-name">
            <strong>{{name}}</strong>
            <span class="owners">{{owners}}</span>
          </div>
          <span class="fate-dice-dots">
            {{#each dots}}<span class="fate-dice-dot{{#if this}} filled{{/if}}"></span>{{/each}}
          </span>
          <span class="fate-dice-member-count">{{points}} / {{../max}}</span>
          <div class="fate-dice-member-actions">
            <button type="button" data-action="plus" data-actor-id="{{id}}">{{localize "FATEDICE.Panel.Plus"}}</button>
            <button type="button" data-action="minus" data-actor-id="{{id}}" {{#unless points}}disabled{{/unless}}>{{localize "FATEDICE.Panel.Minus"}}</button>
            <button type="button" data-action="award" data-actor-id="{{id}}">{{localize "FATEDICE.Panel.Award"}}</button>
            <button type="button" data-action="log" data-actor-id="{{id}}">{{localize "FATEDICE.Panel.Log"}}</button>
          </div>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="fate-dice-panel-empty">{{localize "FATEDICE.Panel.Empty"}}</p>
  {{/if}}
</section>
