{
  "name": "fate-dice",
  "private": true,
  "version": "0.1.0",
  "description": "Dev tooling for the Fate Dice Foundry VTT module. The module itself ships as plain ES modules with no build step.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "test:foundry": "node tools/foundry/run-quench.js && vitest run --config vitest.foundry.config.js",
    "foundry:setup": "node tools/foundry/setup-world.js",
    "build": "node tools/release/build.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
